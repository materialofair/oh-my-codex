        <mxCell id="bg3" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#F4F7FB;gradientColor=#EAF1FF;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="900" as="geometry" />
        </mxCell>
        <mxCell id="title3" value="刷新 → 规格 → 计划 → 实现 → 审查 → 对齐&lt;br&gt;&lt;font style=&quot;font-size:20px;&quot;&gt;动态需求下，关键不是消灭漂移，而是让漂移可见、可控、可对齐&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;strokeColor=none;fillColor=#102A43;fontColor=#FFFFFF;fontSize=30;fontStyle=1;align=center;verticalAlign=middle;spacing=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="50" width="1400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="刷新&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;从代码 / 配置 / Git&lt;br&gt;提取事实&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;strokeColor=#0F8C9D;strokeWidth=3;fillColor=#E9FCFF;fontColor=#102A43;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="215" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="规格&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;明确当前工作单元&lt;br&gt;边界&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;strokeColor=#11A36A;strokeWidth=3;fillColor=#ECFFF6;fontColor=#102A43;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="335" y="250" width="215" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="计划&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;拆解阶段与任务&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;strokeColor=#11A36A;strokeWidth=3;fillColor=#ECFFF6;fontColor=#102A43;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="250" width="215" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="实现&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;按计划推进代码实现&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;strokeColor=#2F6BFF;strokeWidth=3;fillColor=#EEF4FF;fontColor=#102A43;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="845" y="250" width="215" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="审查&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;对照规格 / 计划 / 工作流&lt;br&gt;进行审查&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;strokeColor=#7C5CFA;strokeWidth=3;fillColor=#F4F0FF;fontColor=#102A43;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="250" width="215" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step6" value="对齐&lt;br&gt;&lt;font style=&quot;font-size:16px;&quot;&gt;显式处理意图与事实&lt;br&gt;的分叉&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;strokeColor=#D96C2F;strokeWidth=3;fillColor=#FFF6EF;fontColor=#102A43;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;spacing=14;shadow=1;" vertex="1" parent="1">
