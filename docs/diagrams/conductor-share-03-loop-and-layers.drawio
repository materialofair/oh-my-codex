        <mxCell id="arrow23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B8794;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="step2" target="step3">
