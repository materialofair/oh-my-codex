          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow61" value="持续循环" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D96C2F;strokeWidth=3;fontColor=#D96C2F;fontSize=15;endArrow=block;endFill=1;" edge="1" parent="1" source="step6" target="step1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1445" y="430" />
              <mxPoint x="190" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="intentLayer" value="意图层&lt;br&gt;&lt;font style=&quot;font-size:17px;&quot;&gt;由人确认、相对稳定、不可被机器静默改写&lt;br&gt;&lt;br&gt;product.md&lt;br&gt;product-guidelines.md&lt;br&gt;tech-stack.md&lt;br&gt;workflow.md&lt;br&gt;tracks.md&lt;br&gt;spec.md / plan.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeColor=#11A36A;strokeWidth=4;fillColor=#ECFFF6;fontColor=#102A43;fontSize=23;fontStyle=1;align=left;verticalAlign=top;spacing=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="515" width="630" height="255" as="geometry" />
        </mxCell>
        <mxCell id="factsLayer" value="事实层&lt;br&gt;&lt;font style=&quot;font-size:17px;&quot;&gt;由机器高频刷新，用来暴露现实&lt;br&gt;不要求与意图实时完全一致&lt;br&gt;&lt;br&gt;current.md&lt;br&gt;freshness.json&lt;br&gt;drift.md&lt;br&gt;代码 / 配置 / Git 观察结果&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeColor=#0F8C9D;strokeWidth=4;fillColor=#E9FCFF;fontColor=#102A43;fontSize=23;fontStyle=1;align=left;verticalAlign=top;spacing=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="515" width="630" height="255" as="geometry" />
        </mxCell>
        <mxCell id="callout3" value="关键观念&lt;br&gt;&lt;font style=&quot;font-size:22px;&quot;&gt;漂移是正常的。真正危险的是静默漂移。&lt;br&gt;Conductor 的价值，在于把偏差从隐患变成可治理对象。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeColor=none;fillColor=#102A43;fontColor=#FFFFFF;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;spacing=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="790" width="960" height="85" as="geometry" />
        </mxCell>
