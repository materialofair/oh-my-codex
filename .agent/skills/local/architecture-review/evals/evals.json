    {
      "id": "contract-modes-and-status",
      "type": "content",
      "files": ["SKILL.md"],
      "mustContain": [
        "Choose exactly one primary mode",
        "`design`",
        "`change`",
        "`system`",
        "CLEAR",
        "WATCH",
        "BLOCK",
        "INCONCLUSIVE"
      ]
    },
    {
      "id": "contract-evidence-fields",
      "type": "content",
      "files": ["references/report-format.md"],
      "mustContain": [
        "Evidence:",
        "Boundary expectation:",
        "Scenario:",
        "Impact:",
        "Recommendation:",
        "Tradeoff:",
        "Confidence:"
      ]
    },
    {
      "id": "contract-false-positive-guards",
      "type": "content",
      "files": ["references/architecture-smells.md"],
      "mustContain": [
        "Every concrete dependency needs an interface",
        "Every database access needs a repository",
        "More layers mean better separation",
        "Events always decouple"
      ]
    },
    {
      "id": "behavior-design-mode",
      "type": "behavior",
