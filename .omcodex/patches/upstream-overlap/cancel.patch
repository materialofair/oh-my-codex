+if [[ -f .omc/state/pipeline-state.json ]]; then
+  PIPELINE_STATE=$(cat .omc/state/pipeline-state.json)
+  PIPELINE_ACTIVE=$(echo "$PIPELINE_STATE" | jq -r '.active // false')
+
