{
  "name": "oh-my-codex-cli",
  "version": "1.1.5",
  "description": "Codex skill pack and workflow orchestration",
  "bin": {
    "omcodex": "bin/omcodex.js"
  },
  "files": [
    ".agent",
    ".governance",
    "bin",
    "commands",
    "src",
    "scripts",
    "docs",
    "prompts",
    "templates",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "setup:omcodex": "node bin/omcodex.js setup",
    "doctor:omcodex": "node bin/omcodex.js doctor",
    "source:list": "node bin/omcodex.js source list",
    "source:sync": "node bin/omcodex.js source sync",
    "source:status": "node bin/omcodex.js source status",
    "source:skills:sync": "./scripts/sync-upstream-skills.sh --source all",
    "source:skills:sync:omc": "./scripts/sync-upstream-skills.sh --source oh-my-codex",
    "source:skills:sync:sp": "./scripts/sync-upstream-skills.sh --source superpowers",
    "source:skills:sync:ecc": "./scripts/sync-ecc.sh",
    "skill:migrate": "node scripts/migrate-skill-metadata.js",
    "skill:list": "node bin/omcodex.js skill list",
    "skill:conflicts": "node bin/omcodex.js skill conflicts",
    "install:codex": "./scripts/install-codex.sh",
    "mcp:codex": "./scripts/generate-codex-mcp-config.sh",
    "catalog:generate": "node scripts/generate-catalog-docs.js",
    "governance:skills": "./scripts/check-skill-governance.sh",
    "governance:skills:llm": "node scripts/check-skill-llm-governance.js --mode=auto",
    "governance:skills:sources": "./scripts/test-skill-governance-sources.sh",
    "governance:skills:overlap": "node scripts/report-skill-overlap-governance.js",
    "governance:skills:overlap:multi": "node scripts/report-multi-upstream-overlap.js",
    "governance:skills:patches": "./scripts/generate-upstream-overlap-patches.sh",
    "harness:graph": "node bin/omcodex.js harness graph",
    "harness:intents": "node bin/omcodex.js harness intents",
    "harness:lint": "node bin/omcodex.js harness lint",
    "harness:migrate": "node scripts/add-harness-metadata.js",
    "governance:harness": "./scripts/check-harness-governance.sh",
    "eval:skills": "node scripts/eval-skills.js",
    "test:llm": "node bin/omcodex.js test llm all --router-cases tests/llm/router-cases.json",
    "test:llm:router": "node bin/omcodex.js test llm router --cases tests/llm/router-cases.json",
    "test:llm:prompts": "node bin/omcodex.js test llm prompts --cases tests/llm/prompt-contract-cases.json",
    "test:llm:workflow": "node bin/omcodex.js test llm workflow",
    "test:ai:detect-stack": "node bin/omcodex.js test detect-stack",
    "test:ai:changed": "node bin/omcodex.js test changed --limit 2",
    "test:ai:sample": "node bin/omcodex.js test gen src/router/skill-router.js",
    "test:merger": "node scripts/test-merger.js",
    "test:similarity": "node scripts/test-similarity.js",
    "test": "npm run governance:skills && npm run governance:skills:llm && npm run catalog:generate && npm run eval:skills && node bin/omcodex.js doctor",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run source:skills:sync -- --skip-fetch && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "openai",
    "ai-agent",
    "workflow",
    "skills"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "license": "MIT"
}
